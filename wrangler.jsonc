{
  "name": "image-teasers",
  "compatibility_date": "2026-11-23",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "image-teasers",
    },
  ],
}
